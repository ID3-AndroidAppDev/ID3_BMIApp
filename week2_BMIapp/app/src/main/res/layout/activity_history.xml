<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_ink_black">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_prussian_blue"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="4dp"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/ds_alabaster_grey"
            app:title="@string/title_history"
            app:titleTextColor="@color/ds_alabaster_grey"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleCentered="false"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp"
            android:paddingTop="16dp">

            <!-- Count chip -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/ds_dusk_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/ds_alabaster_grey"
                        android:contentDescription="History count icon"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvHistoryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history_count_one"
                        android:textSize="14sp"
                        android:textColor="@color/ds_alabaster_grey"
                        android:letterSpacing="0.01"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowBest"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_show_best"
                app:cornerRadius="14dp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowAverage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_show_average"
                app:cornerRadius="14dp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewStatistics"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_view_dashboard"
                app:cornerRadius="14dp"
                android:visibility="gone"/>

            <!-- Best BMI result card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvBestResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/ds_prussian_blue"
                app:strokeWidth="1dp"
                app:strokeColor="@color/ds_dusk_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvBestTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_best_bmi_title"
                        android:textSize="13sp"
                        android:textColor="@color/ds_lavender_grey"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/tvBestBmi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        android:textColor="@color/ds_lavender_grey"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvBestCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="@color/ds_alabaster_grey"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Average BMI result card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvAverageResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/ds_prussian_blue"
                app:strokeWidth="1dp"
                app:strokeColor="@color/ds_dusk_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_avg_bmi"
                        android:textSize="13sp"
                        android:textColor="@color/ds_lavender_grey"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/tvAvgBmi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        android:textColor="@color/ds_dusk_blue"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvAvgCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="@color/ds_alabaster_grey"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Divider before history list -->
            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:background="@color/ds_prussian_blue"
                android:visibility="gone"/>

            <!-- History entries -->
            <TextView
                android:id="@+id/historyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.6"
                android:textColor="@color/ds_alabaster_grey"
                android:visibility="gone"/>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/llEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="64dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/ds_dusk_blue"
                    android:contentDescription="No history"
                    android:alpha="0.6"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_no_records"
                    android:textSize="16sp"
                    android:textColor="@color/ds_lavender_grey"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_start_hint"
                    android:textSize="13sp"
                    android:textColor="@color/ds_lavender_grey"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Clear FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabClearHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/fab_clear"
        app:icon="@drawable/ic_delete"
        app:iconTint="@color/ds_alabaster_grey"
        android:textColor="@color/ds_alabaster_grey"
        app:backgroundTint="@color/ds_dusk_blue"
        app:elevation="4dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
